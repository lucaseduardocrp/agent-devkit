# Shell scripts also run on macOS and Linux: always LF.
*.sh text eol=lf
# Windows launchers: always CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Built-in skills are listed in the ADK Hub (agent-devkit-hub), downloaded raw from GitHub and
# checked against hashes in its index: keep the working tree byte-identical on every platform.
apps/Mcp/skills/** text eol=lf
