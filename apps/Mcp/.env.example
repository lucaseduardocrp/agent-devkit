# ADK API the MCP server talks to (no trailing slash).
ADK_API_URL=http://localhost:3000
# Optional: a session token; `devkit login` stores one in ADK_MCP_SESSION_FILE instead.
# ADK_TOKEN=
# Optional: default workspace (otherwise use the workspaces_select tool).
# ADK_WORKSPACE_ID=
# Optional: pt-BR | en-US for backend messages.
# ADK_LOCALE=pt-BR
# Optional: comma-separated toolsets (account, workspaces, integrations, brain, agents, spec,
# testplans, design, audit). Empty = all.
# ADK_MCP_TOOLSETS=brain,spec,testplans
# Optional: expose read-only tools only.
# ADK_MCP_READ_ONLY=false
# Optional: where `devkit login` stores the session (default ~/.adk/mcp-session.json).
# ADK_MCP_SESSION_FILE=
# Optional: request timeout for ADK API calls (server-model generations can be slow).
# ADK_MCP_TIMEOUT_MS=180000
# HTTP transport (devkit http).
# ADK_MCP_HTTP_HOST=127.0.0.1
# ADK_MCP_HTTP_PORT=3333   (falls back to PORT, which platforms such as Railway inject)
# Comma-separated Host headers accepted (DNS-rebinding protection); empty = any.
# ADK_MCP_ALLOWED_HOSTS=mcp.example.com
# Require `Authorization: Bearer <ADK token>`; defaults to true when not bound to loopback.
# ADK_MCP_REQUIRE_AUTH=true
# Remote connectors (claude.ai, Claude Code over HTTP): public https URL of this server and a
# 32+ character secret enable the OAuth 2.1 authorization server (/authorize, /token, /register).
# ADK_MCP_PUBLIC_URL=https://mcp.example.com
# ADK_MCP_OAUTH_SECRET=
# Honour X-Forwarded-* from one proxy hop (set in the Docker image).
# ADK_MCP_TRUST_PROXY=true
# Requests per minute per client IP on /mcp and the OAuth endpoints.
# ADK_MCP_RATE_LIMIT=600
