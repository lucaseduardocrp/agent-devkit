{
  "name": "@agent-devkit/mcp",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "ADK MCP server for Claude, Codex and other assistants (stdio and Streamable HTTP with OAuth). Deployed to Railway and embedded in @agent-devkit/cli; not published on its own.",
  "type": "module",
  "bin": {
    "devkit-mcp": "dist/src/bin/devkit-mcp.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/bin/devkit-mcp.js",
    "dev": "node --experimental-strip-types src/bin/devkit-mcp.ts",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,json,yml,yaml}\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "parity": "vitest run tests/parity.test.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaseduardocrp/agent-devkit.git",
    "directory": "apps/Mcp"
  }
}
