{
  "name": "@agent-devkit/cli",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "ADK command line (devkit): sign-in, local E2E runner, tunnels, skills and the local MCP server.",
  "type": "module",
  "bin": {
    "devkit": "dist/src/bin/devkit.js"
  },
  "imports": {
    "#mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/mcp",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --prefix ../Mcp && node scripts/embed-mcp.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/src/bin/devkit.js",
    "dev": "node --experimental-strip-types src/bin/devkit.ts",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,json,yml,yaml}\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "prepublishOnly": "npm run build",
    "sync-e2e-runner": "node scripts/sync-e2e-runner.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.64.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "playwright": "1.64.1",
    "undici": "8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaseduardocrp/agent-devkit.git",
    "directory": "apps/Cli"
  }
}
