{
  "name": "@agent-devkit/cli",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "ADK command line (devkit): sign-in, local E2E runner, tunnels, skills and the local MCP server.",
  "type": "module",
  "bin": {
    "devkit": "dist/src/bin/devkit.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/bin/devkit.js",
    "dev": "node --experimental-strip-types src/bin/devkit.ts",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,json,yml,yaml}\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "prepublishOnly": "npm run build",
    "sync-e2e-runner": "node scripts/sync-e2e-runner.mjs"
  },
  "dependencies": {
    "@agent-devkit/mcp": "file:../Mcp",
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaseduardocrp/agent-devkit.git",
    "directory": "apps/Cli"
  }
}
