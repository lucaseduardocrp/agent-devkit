{
  "name": "@adk/frontend",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{html,js,mjs,cjs,ts,tsx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{html,js,mjs,cjs,ts,tsx,json,yml,yaml}\"",
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,mjs,cjs,ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "start": "vite",
    "preview": "vite preview",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n-hardcoded.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run i18n:check && npm run test:coverage"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
