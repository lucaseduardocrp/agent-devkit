# Base URL of the backend API. Vite compiles it into the build.
# - Local development: leave unset. Vite's dev server proxies API paths to
#   http://localhost:3000 (see vite.config.ts), and ApiClient's own default
#   also points there.
# - Railway: the template sets it to https://${{API.RAILWAY_PUBLIC_DOMAIN}}; the
#   Dockerfile receives it as a build argument.
# - Vercel (production/preview): set this to the deployed backend URL,
#   e.g. https://your-backend.up.railway.app
VITE_API_BASE_URL=
