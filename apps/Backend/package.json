{
  "name": "@adk/backend",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc --noEmit false --outDir dist",
    "start": "node --env-file=.env dist/src/bootstrap/server.js",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml}\"",
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,mjs,cjs,ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n-hardcoded.mjs",
    "e2e:install-browsers": "playwright install chromium",
    "verify": "npm run prisma:generate && npm run format:check && npm run lint && npm run typecheck && npm run i18n:check && npm run test:coverage",
    "prestart": "node scripts/build-before-start.mjs && node --env-file=.env scripts/migrate-before-start.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@playwright/test": "1.63.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "aws4fetch": "1.0.20",
    "docx": "9.8.1",
    "dotenv": "17.2.2",
    "express": "^5.1.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "0.20.2",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
