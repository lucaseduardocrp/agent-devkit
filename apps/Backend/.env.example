NODE_ENV=development
# Railway injects its own PORT at runtime; only set this for local development.
PORT=3000
LOG_LEVEL=info
DATABASE_PROVIDER=postgres
# postgresql://<user>:<password>@localhost:5432/<database>
DATABASE_URL=
# Optional read cache shared by API instances, e.g. redis://localhost:6379. Without it each
# instance caches in its own memory.
# REDIS_URL=
# Use a non-pooled URL for Prisma CLI operations when DATABASE_URL is pooled.
# Not needed on Railway's own Postgres plugin, which issues a single URL.
# DIRECT_URL=
# Required. 32-byte key (64 hex chars) that encrypts stored integration secrets.
# The API and the E2E worker refuse to start without it, and both must use the
# same value. Changing it later makes saved integrations unreadable.
# Generate one with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# SMTP server used for account-recovery codes. Any standard
# SMTP provider works; credentials are optional for a local SMTP server.
# Alternatively provide a complete Nodemailer URL in SMTP_URL.
# SMTP_URL=smtps://user:app-password@smtp.example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=adk <no-reply@example.com>

# Public application URLs used by OAuth callbacks.
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Signs OAuth state; Google and GitHub sign-in stay disabled while it is empty.
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=
# Pepper for account-recovery code hashes. When empty, OAUTH_STATE_SECRET or
# INTEGRATION_ENCRYPTION_KEY is used. Generate with: openssl rand -hex 32
AUTH_CODE_SECRET=

# Create OAuth applications in Google Cloud Console and GitHub Developer Settings.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# E2E Automation (Playwright). Install the browser once with: npm run e2e:install-browsers
# Without E2E_WORKER_URL the API runs the tests itself (local development).
# With it, the API only enqueues jobs in Postgres and wakes the on-demand worker service
# (Dockerfile.e2e-worker / railway.e2e-worker.json). Use the same long random token on both.
# E2E_WORKER_URL=https://your-e2e-worker.up.railway.app
# E2E_WORKER_TOKEN=   (generate with: openssl rand -hex 32)
# Runs executed in parallel per worker instance (each Chromium needs ~0.5 vCPU / 500 MB).
# E2E_WORKER_CONCURRENCY=2
# Where test videos live (the API and the worker must use the same settings):
# 1. Cloudflare R2, when E2E_R2_URL is set. Browsers stream videos through signed URLs.
#    Create an R2 API token with "Object Read & Write" on the bucket.
# E2E_R2_URL=https://<account-id>.r2.cloudflarestorage.com/<bucket>
# E2E_R2_ACCESS_KEY_ID=
# E2E_R2_SECRET_ACCESS_KEY=
# Folder inside the bucket (default: e2e).
# E2E_R2_PREFIX=e2e
# 2. Otherwise Postgres, when a database is configured.
# 3. Otherwise this local folder (development only).
# E2E_ARTIFACTS_DIR=./.e2e-artifacts
# Optional custom Playwright browser cache location.
# PLAYWRIGHT_BROWSERS_PATH=
# Videos are re-encoded to H.264 MP4 (playable in VS Code) with the bundled FFmpeg;
# set this to use another ffmpeg binary instead.
# FFMPEG_PATH=

# ADK Hub: agents installed from the Agents page (Hub tab), devkit agents and agents_hub_* tools.
# Another hub index, e.g. a mirror for servers without access to GitHub (default: the public hub).
# ADK_HUB_URL=
# Any read-only GitHub token; lifts GitHub's limit of 60 anonymous API calls an hour.
# ADK_HUB_GITHUB_TOKEN=
