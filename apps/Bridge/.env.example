# ADK mode (recommended): the ADK API owns the Telegram bot and forwards paired chats here.
# Use the same value in the API's BRIDGE_SHARED_TOKEN (at least 16 random characters).
BRIDGE_SHARED_TOKEN=
# Where the ADK API is (the replies go through it).
BRIDGE_ADK_URL=http://localhost:3000
BRIDGE_HTTP_PORT=3500

# Standalone mode (optional): this process polls its OWN bot. Never the bot configured in ADK.
TELEGRAM_BOT_TOKEN=
# Telegram user ids allowed in standalone mode. Send /whoami to the bot to find yours.
BRIDGE_ALLOWED_USER_IDS=

BRIDGE_DEFAULT_CLI=claude
# safe = read-only tools, auto = the CLI may edit files and run commands without asking.
BRIDGE_DEFAULT_MODE=auto
BRIDGE_LANG=pt
# Encrypts the users' CLI credentials (default: BRIDGE_SHARED_TOKEN). Changing it makes the saved
# accounts unreadable, so set a dedicated one and keep it.
BRIDGE_ENCRYPTION_KEY=
# There are no shared CLI credentials: each user connects their own account from Telegram with
# /auth <cli> <key> (see docs/bridge.md).
